# Groq — generation + grading LLM. Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_GENERATION_MODEL=llama-3.3-70b-versatile
GROQ_GRADER_MODEL=llama-3.1-8b-instant

# Jina AI — embeddings. Get a key at https://jina.ai/embeddings
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_VECTOR_SIZE=1024

# Qdrant — vector store. Use Qdrant Cloud (https://cloud.qdrant.io) or self-hosted.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
